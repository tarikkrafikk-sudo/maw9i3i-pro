# =============================================================================
# MAW9I3I.PRO — نظام الأداء — .env.example
# انسخ هاد الملف إلى ".env" وعمّر القيم الحقيقية ديالك.
# ⚠️ ملف .env ما خاصوش يتزاد لـ Git أو يبقى بلا حماية — عندو معلومات سرية.
# =============================================================================

# ---------- قاعدة البيانات (MySQL) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maw9i3i_payments
DB_USER=your_db_user
DB_PASS=your_db_password

# ---------- الموقع ----------
SITE_URL=https://www.maw9i3i-pro.com
ADMIN_EMAIL=contact@maw9i3i-pro.com
ADMIN_WHATSAPP_NUMBER=212695062076
MAIL_FROM=no-reply@maw9i3i-pro.com
MAIL_FROM_NAME=MAW9I3I.PRO

# ---------- YouCan Pay ----------
# جيبهم من: https://youcanpay.com (Dashboard → API Keys)
YOUCAN_PRIVATE_KEY=pri_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUCAN_PUBLIC_KEY=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# true = وضع تجريبي (sandbox)، false = وضع حقيقي (production)
YOUCAN_SANDBOX=true

# ---------- لوحة التحكم /admin ----------
ADMIN_USERNAME=admin
# كلمة سر بسيطة (نص عادي)، أو bcrypt hash (كيبدا بـ $2y$) لأمان أفضل.
# لتوليد hash: php -r "echo password_hash('كلمة_السر_ديالك', PASSWORD_BCRYPT);"
ADMIN_PASSWORD=change_me_please

# ---------- CRON ----------
# رمز سري باش تحمي pay/cron.php إلا كنت غادي تشغلو عبر رابط HTTP (wget/curl)
# بدل SSH. ولّد رمز عشوائي طويل (32+ حرف).
CRON_SECRET=change_this_to_a_long_random_string

# ---------- مفتاح داخلي (اختياري) ----------
# كيتستعمل لتوقيع روابط أداء الـ70% الباقية. إلا خليتو فارغ، غادي يتولد
# تلقائيا من DB_NAME + ADMIN_USERNAME (يخدم لكن حط قيمة خاصة بيك أحسن).
APP_SECRET=
